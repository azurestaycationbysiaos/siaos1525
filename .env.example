# --- Outstatic CMS setup ---
# Free self-hosting via your own GitHub OAuth app (recommended, no paid tier needed)
OST_GITHUB_ID=your_github_oauth_app_id
OST_GITHUB_SECRET=your_github_oauth_app_secret

# Your GitHub repo slug, e.g. for github.com/yourname/azure-staycation this is:
OST_REPO_SLUG=azure-staycation

# Optional but recommended
OST_REPO_BRANCH=main
OST_TOKEN_SECRET=replace_with_a_random_32_character_string
